# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role. Bypasses RLS entirely -- server-side only, never in a
# 'use client' file or anything under src/components.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# Stripe Connect. Each organization is a connected account receiving its own
# registration money; the platform keys below are ours, not theirs.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Web Push (VAPID). Generate once: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
